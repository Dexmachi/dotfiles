#!/usr/bin/env bash
#   _____    __                  __
#  / __(_)__/ /__ ___  ___ ____/ /
# _\ \/ / _  / -_) _ \/ _ `/ _  /
# /___/_/\_,_/\__/ .__/\_,_/\_,_/
#               /_/
# Main Script

# --- Configuration ---
WINDOW_CLASS="dotfiles-sidepad"
WINDOW_INITIAL_TITLE="dotfiles-sidepad"
HIDDEN_LEFT_GAP=0
VISIBLE_LEFT_GAP=20
TARGET_WIDTH=500
TARGET_WIDTH_MAX=1000
TOP_GAP=76
BOTTOM_GAP=91

# --- Script Variables ---
HIDE_REQUESTED=0

# --- Help Function ---
show_help() {
  echo "Usage: $0 [options]"
  echo "Please make sure that you're using the class or initialTitle only once."
  echo "The window must be in floating mode."
  echo ""
  echo "Options:"
  echo "  --class <name>          Override the window class (Default: $WINDOW_CLASS)"
  echo "  --title <name>          Override the window initial title (Default: $WINDOW_INITIAL_TITLE)"
  echo "  --hidden-gap <px>       Override the hidden left gap (Default: $HIDDEN_LEFT_GAP)"
  echo "  --visible-gap <px>      Override the visible left gap (Default: $VISIBLE_LEFT_GAP)"
  echo "  --width <px>            Override the target width (Default: $TARGET_WIDTH)"
  echo "  --width-max <px>        Override the maximum target width (Default: $TARGET_WIDTH_MAX)"
  echo "  --top-gap <px>          Override the top gap (Default: $TOP_GAP)"
  echo "  --bottom-gap <px>       Override the bottom gap (Default: $BOTTOM_GAP)"
  echo "  --hide                  Force the window to the hidden state."
  echo "  --kill                  Kills the running app."
  echo "  --test                  Test for running app."
  echo "  -h, --help              Display this help and exit"
  exit 0
}

test_sidepad() {
  if ! hyprctl clients -j | jq -e --arg class "$WINDOW_CLASS" --arg initialTitle "$WINDOW_INITIAL_TITLE" '.[] | select(.class == $class or .initialTitle == $initialTitle)' >/dev/null; then
    echo "1"
    return 1
  else
    echo "0"
    return 0
  fi
}

init_sidepad() {
  # Check if the window already exists, if not launch it
  if ! hyprctl clients -j | jq -e --arg class "$WINDOW_CLASS" --arg initialTitle "$WINDOW_INITIAL_TITLE" '.[] | select(.class == $class or .initialTitle == $initialTitle)' >/dev/null; then
    notify-send "Sidepad will be initialized with" "$1"
    eval "$1" &

    # Wait for the window to appear, with a timeout
    for i in {1..100}; do # ~10 seconds timeout
      if hyprctl clients -j | jq -e --arg class "$WINDOW_CLASS" --arg initialTitle "$WINDOW_INITIAL_TITLE" '.[] | select(.class == $class or .initialTitle == $initialTitle)' >/dev/null; then
        break
      fi
      sleep 0.1
    done
  fi
}

kill_sidepad() {
  # --- CORREÇÃO SINTAXE JQ ---
  # Envolve a expressão em colchetes `[...]` para criar um array antes de pegar o índice `[0]`.
  WINDOW_PID=$(hyprctl clients -j | jq -r \
    --arg class "$WINDOW_CLASS" \
    --arg initialTitle "$WINDOW_INITIAL_TITLE" \
    '[ .[] | select(.class == $class or .initialTitle == $initialTitle) ][0] | .pid // empty')

  if [ -n "$WINDOW_PID" ] && [ "$WINDOW_PID" -ne -1 ]; then
    echo "Killing process with PID $WINDOW_PID for '$WINDOW_CLASS' or '$WINDOW_INITIAL_TITLE'."
    kill "$WINDOW_PID"
  else
    echo "Error: Window with class '$WINDOW_CLASS' or title '$WINDOW_INITIAL_TITLE' not found." >&2
  fi
  sleep 1
  exit 0
}

# --- Parse Command-line Options ---
while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
  --class)
    WINDOW_CLASS="$2"
    shift 2
    ;;
  --title)
    WINDOW_INITIAL_TITLE="$2"
    shift 2
    ;;
  --hidden-gap)
    HIDDEN_LEFT_GAP="$2"
    shift 2
    ;;
  --visible-gap)
    VISIBLE_LEFT_GAP="$2"
    shift 2
    ;;
  --width)
    TARGET_WIDTH="$2"
    shift 2
    ;;
  --width-max)
    TARGET_WIDTH_MAX="$2"
    shift 2
    ;;
  --top-gap)
    TOP_GAP="$2"
    shift 2
    ;;
  --bottom-gap)
    BOTTOM_GAP="$2"
    shift 2
    ;;
  --hide)
    HIDE_REQUESTED=1
    shift
    ;;
  --test)
    test_sidepad
    exit 0
    ;;
  --kill)
    kill_sidepad
    ;;
  --init)
    SIDEPAD_APP="$2"
    init_sidepad "$SIDEPAD_APP"
    HIDE_REQUESTED=1
    shift 2
    ;;
  -h | --help)
    show_help
    ;;
  *)
    shift
    ;;
  esac
done

# --- Get Window and Monitor Info ---
# --- CORREÇÃO SINTAXE JQ ---
# Envolve a expressão em colchetes `[...]` para criar um array antes de pegar o índice `[0]`.
WINDOW_INFO=$(hyprctl clients -j | jq \
  --arg class "$WINDOW_CLASS" \
  --arg initialTitle "$WINDOW_INITIAL_TITLE" \
  '[ .[] | select(.class == $class or .initialTitle == $initialTitle) ][0]')

MONITOR_INFO=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true)')

if [ -z "$WINDOW_INFO" ] || [ "$WINDOW_INFO" == "null" ]; then
  echo "Error: Window with class '$WINDOW_CLASS' or title '$WINDOW_INITIAL_TITLE' not found. Is the window open?"
  exit 1
fi

WINDOW_ADDRESS=$(echo "$WINDOW_INFO" | jq -r '.address')
WINDOW_WIDTH=$(echo "$WINDOW_INFO" | jq -r '.size[0]')
WINDOW_HEIGHT=$(echo "$WINDOW_INFO" | jq -r '.size[1]')
WINDOW_X=$(echo "$WINDOW_INFO" | jq -r '.at[0]')
WINDOW_Y=$(echo "$WINDOW_INFO" | jq -r '.at[1]')
MONITOR_HEIGHT=$(echo "$MONITOR_INFO" | jq -r '.height')

# --- Main Logic ---

# Case 1: --hide flag is used, unconditionally hide the window.
if [[ "$HIDE_REQUESTED" -eq 1 ]]; then
  if ((WINDOW_X >= 0)); then # Only act if it is not already hidden
    echo "--- Hiding window (--hide) ---"
    PIXELS_TO_MOVE_X=$(((WINDOW_X * -1) - TARGET_WIDTH + HIDDEN_LEFT_GAP))
    WIDTH_CHANGE=$((TARGET_WIDTH - WINDOW_WIDTH))
    PIXELS_TO_MOVE_Y=$((TOP_GAP - WINDOW_Y))
    TARGET_HEIGHT=$((MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP))
    HEIGHT_CHANGE=$((TARGET_HEIGHT - WINDOW_HEIGHT))

    hyprctl --batch "dispatch resizewindowpixel $WIDTH_CHANGE $HEIGHT_CHANGE,address:$WINDOW_ADDRESS; dispatch movewindowpixel $PIXELS_TO_MOVE_X $PIXELS_TO_MOVE_Y,address:$WINDOW_ADDRESS"
    echo "Operation completed."
  else
    echo "Window is already hidden."
  fi
  exit 0
fi

# Case 2: Window is hidden, so show it.
if ((WINDOW_X < 0)); then
  echo "--- Showing window ---"
  PIXELS_TO_MOVE_X=$((VISIBLE_LEFT_GAP - WINDOW_X))
  WIDTH_CHANGE=$((TARGET_WIDTH - WINDOW_WIDTH))
  PIXELS_TO_MOVE_Y=$((TOP_GAP - WINDOW_Y))
  TARGET_HEIGHT=$((MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP))
  HEIGHT_CHANGE=$((TARGET_HEIGHT - WINDOW_HEIGHT))

  hyprctl --batch "dispatch resizewindowpixel $WIDTH_CHANGE $HEIGHT_CHANGE,address:$WINDOW_ADDRESS; dispatch movewindowpixel $PIXELS_TO_MOVE_X $PIXELS_TO_MOVE_Y,address:$WINDOW_ADDRESS"
  echo "Operation completed."

# Case 3: Window is visible, so toggle its width and correct its position.
else
  PIXELS_TO_MOVE_Y=$((TOP_GAP - WINDOW_Y))
  TARGET_HEIGHT=$((MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP))
  HEIGHT_CHANGE=$((TARGET_HEIGHT - WINDOW_HEIGHT))
  PIXELS_TO_MOVE_X=0

  if ((WINDOW_WIDTH == TARGET_WIDTH)); then
    echo "--- Expanding width to max ---"
    WIDTH_CHANGE=$((TARGET_WIDTH_MAX - WINDOW_WIDTH))
  else
    echo "--- Shrinking width to default ---"
    WIDTH_CHANGE=$((TARGET_WIDTH - WINDOW_WIDTH))
  fi

  hyprctl --batch "dispatch resizewindowpixel $WIDTH_CHANGE $HEIGHT_CHANGE,address:$WINDOW_ADDRESS; dispatch movewindowpixel $PIXELS_TO_MOVE_X $PIXELS_TO_MOVE_Y,address:$WINDOW_ADDRESS"
  echo "Operation completed."
fi

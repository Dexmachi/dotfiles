# Theme
theme = "tema-wallust-matugen.conf"

# Font Configuration
font-family = "Maple Mono NF CN"
font-style = "Medium"
font-style-bold = "Bold"
font-style-italic = "Medium Italic"
font-style-bold-italic = "Bold Italic"
font-size = 12
font-synthetic-style = false

# Window Padding and Layout
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = none
background-opacity = 0.90
window-save-state = never
title = " "
gtk-titlebar = false

# Cursor Configuration
cursor-style = underline
cursor-style-blink = true
shell-integration-features = no-cursor

# Bell and Confirmation
bell-features = no-audio
confirm-close-surface = false
scrollback-limit = 2000

# Tab Configuration
window-show-tab-bar = never
gtk-tabs-location = hidden
gtk-single-instance = false

# Clipboard Configuration
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

# Keybindings
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+tab=ignore
keybind = ctrl+shift+tab=ignore

# Mouse
mouse-hide-while-typing = true

#p10k
zinit light romkatv/powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# -----------------------------------------------------
# PLUGINS
# -----------------------------------------------------
# --- OMZ PLUGINS ---
plugins=(
    git
    sudo
    web-search
    archlinux
    copyfile
    copybuffer
    dirhistory
)

zinit ice wait lucid
for plugin in $plugins
do
  zinit snippet "OMZP::$plugin"
done

# --- PLUGINS EXTERNOS ---
zinit light zsh-users/zsh-autosuggestions

zinit light zsh-users/zsh-history-substring-search
zinit light zdharma-continuum/fast-syntax-highlighting

zinit ice wait lucid
zinit light Aloxaf/fzf-tab
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'

zinit ice wait lucid
zinit light olets/zsh-abbr

source ~/.config/zshrc/scripts/p10k-jj-status.plugin.zsh

# -----------------------------------------------------
# ALIASES / BINDS
# -----------------------------------------------------

eval $(glab completion --shell zsh)
eval $(sops completion zsh)
tre() { command tre "$@" -e && source "/tmp/tre_aliases_$USER" 2>/dev/null; }

# keybinds
bindkey '^F' autosuggest-accept

bindkey "^[[A" history-substring-search-up
bindkey "^[[B" history-substring-search-down

# Notebook Dir
export ZK_NOTEBOOK_DIR="$HOME/diario"

# -----------------------------------------------------
# FZF CONFIG
# -----------------------------------------------------
# Carrega bindings do fzf se instalado
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
fi


zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=**'
zstyle ':fzf-tab:complete:glab:*' script "${_glab_completion}"
zstyle ':fzf-tab:complete:glab:*:*' fzf-flags '--layout=reverse --info=inline'

# -----------------------------------------------------
# HISTORY SETTINGS
# -----------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt extendedglob

autoload -Uz add-zsh-hook

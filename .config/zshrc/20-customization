
# -----------------------------------------------------
# Zinit Bootstrapping (auto-install se não existir)
# -----------------------------------------------------
if [[ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/bin" ]]; then
  mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/zinit" && \
  git clone https://github.com/zdharma-continuum/zinit.git \
    "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/bin"
fi
source "${XDG_DATA_HOME:-$HOME/.local/share}/zinit/bin/zinit.zsh"

# -----------------------------------------------------
# THEME (Powerlevel10k)
# -----------------------------------------------------
zinit ice lucid
zinit light romkatv/powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

autoload -Uz compinit
compinit

# -----------------------------------------------------
# PLUGINS (OMZ + externos)
# -----------------------------------------------------
# --- OMZ PLUGINS ---
zinit ice wait lucid
zinit snippet OMZP::git

zinit ice wait lucid
zinit snippet OMZP::sudo

zinit ice wait lucid
zinit snippet OMZP::web-search

zinit ice wait lucid
zinit snippet OMZP::archlinux

zinit ice wait lucid
zinit snippet OMZP::copyfile

zinit ice wait lucid
zinit snippet OMZP::copybuffer

zinit ice wait lucid
zinit snippet OMZP::dirhistory

# --- PLUGINS EXTERNOS ---
zinit light zsh-users/zsh-autosuggestions

zinit light zdharma-continuum/fast-syntax-highlighting

zinit ice wait lucid
zinit light Aloxaf/fzf-tab
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'

zinit ice wait lucid
zinit light olets/zsh-abbr

# -----------------------------------------------------
# ALIASES / BINDS
# -----------------------------------------------------
eval $(thefuck --alias)
tre() { command tre "$@" -e && source "/tmp/tre_aliases_$USER" 2>/dev/null; }

# keybinds
bindkey '^F' autosuggest-accept

# Notebook Dir
export ZK_NOTEBOOK_DIR="$HOME/diario"

# -----------------------------------------------------
# FZF CONFIG
# -----------------------------------------------------
# Carrega bindings do fzf se instalado
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
fi

# -----------------------------------------------------
# HISTORY SETTINGS
# -----------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt extendedglob

autoload -Uz add-zsh-hook

